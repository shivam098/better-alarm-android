<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BetterAlarm" parent="android:Theme.Material.NoActionBar" />

    <!--
        The ringing theme is deliberately separate: no action bar, translucent
        status bar and a black background so the screen turning on at 3am is as
        dim as possible until Compose draws.
    -->
    <style name="Theme.BetterAlarm.Ringing" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>