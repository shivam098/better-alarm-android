<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <include domain="file" path="alarms.json" />
    <include domain="file" path="occurrences.json" />
    <!--
        Deliberately NOT backed up: the pending-alarm bookkeeping. Restoring it
        onto another device would describe AlarmManager registrations that do
        not exist there. It is rebuilt from alarms.json on first launch anyway.
    -->
    <exclude domain="file" path="pending.json" />
</full-backup-content>